{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "markL",
  "version": "0.2.0",
  "identifier": "de.end3.markl",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run licenses:check && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "markL",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "visible": false,
        "create": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' markl-image: http://markl-image.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (C) 2026 Sebastian EC",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/heyplusyou/markL",
    "shortDescription": "A lightweight markdown editor",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["txt"],
        "name": "Text document",
        "mimeType": "text/plain",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
